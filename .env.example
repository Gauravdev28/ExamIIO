# ==============================================================================
# CODEGUARD — Environment Configuration Template
# NOTE: The default values below are for LOCAL DEVELOPMENT ONLY.
# In PRODUCTION, all secrets and passwords must be replaced with strong,
# unique random values. Production settings will FAIL CLOSED if default
# development credentials or keys are detected.
# ==============================================================================

# Application Core
DJANGO_ENV=development
DJANGO_SETTINGS_MODULE=codeguard.settings.development
DEBUG=True
# PRODUCTION: Must be set to a cryptographically strong secret (>50 chars). Cannot use dev default.
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-50-chars-codeguard-platform-2026
ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (MySQL 8)
DB_ENGINE=django.db.backends.mysql
DB_NAME=codeguard_db
DB_USER=codeguard_user
DB_PASSWORD=codeguard_secure_password
DB_HOST=127.0.0.1
DB_PORT=3306
MYSQL_ROOT_PASSWORD=root_secure_password

# SQLite Fallback (Optional for standalone testing without MySQL running)
USE_SQLITE_DEV=False

# Cache, Channel Layers & Message Broker (Redis 7)
REDIS_PASSWORD=dev_redis_secure_password
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=jwt-dev-secret-key-change-in-production-codeguard

# Code Execution Sandbox (Piston - Primary Execution Engine)
CODE_EXECUTION_PROVIDER=PISTON
# When running outside Docker (local bare-metal): http://127.0.0.1:2000
# When running inside Docker Compose: http://piston:2000
PISTON_URL=http://127.0.0.1:2000

# Code Execution Sandbox (Judge0 - Compatibility/Secondary)
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=
JUDGE0_TIMEOUT_SECONDS=10
JUDGE0_POSTGRES_PASSWORD=judge0_secure_password
JUDGE0_REDIS_PASSWORD=judge0_redis_pass

# SQL Sandbox Execution (Isolated MySQL Sandbox)
SQL_SANDBOX_HOST=127.0.0.1
SQL_SANDBOX_PORT=3306
SQL_SANDBOX_ADMIN_USER=root
SQL_SANDBOX_ADMIN_PASSWORD=root_secure_password
SQL_SANDBOX_TIMEOUT_SECONDS=3

# Data Retention Lifecycle & DSAR Encryption
RETENTION_PERIOD_DAYS=30
RETENTION_PURGE_BATCH_SIZE=50
# PRODUCTION: Mandatory 64-character hex string (32 bytes). Cannot use dev default.
DSAR_MASTER_KEY_V1=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Media & Static Files
MEDIA_ROOT=media
STATIC_ROOT=staticfiles

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
