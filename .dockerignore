# ==============================================================================
# CODEGUARD — Docker Build Context Exclusions (.dockerignore)
# Prevents baking local secrets, environment files, development databases,
# media, and temporary artifacts into container images.
# ==============================================================================

# Environment files and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
*.p12

# Version control
.git
.git/
.gitignore

# Python temporary and cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
.venv/
venv/
ENV/
build/
dist/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
celerybeat-schedule*
backend/celerybeat-schedule*

# Local databases and journals
*.sqlite3
*.sqlite3-journal
db.sqlite3
backend/db.sqlite3
backend/db.sqlite3-journal

# Media and user data (sensitive proctoring, evidence, certificates, exports)
media/
backend/media/
backend/staticfiles/

# Node and frontend artifacts
node_modules/
frontend/node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*

# OS and IDE files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
